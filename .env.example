# LLM API Key (required) — Bearer Token for school proxy
LLM_API_KEY=your-api-key-here

# LLM Base URL (optional, default: https://njusehub.info/v1)
LLM_BASE_URL=https://njusehub.info/v1

# LLM Model (optional, default: deepseek-v4-flash)
LLM_MODEL=deepseek-v4-flash

# LLM Request Timeout in seconds (optional, default: 180)
# Increase if you get frequent APITimeoutError, especially for long paper generation.
# The school proxy may add extra latency; 300s is safe for full survey generation.
LLM_TIMEOUT=180

# Semantic Scholar API Key (optional)
SEMANTIC_SCHOLAR_API_KEY=

# Google Scholar Cookie (optional, reserved for phase 2)
GOOGLE_SCHOLAR_COOKIE=